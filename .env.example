# AI provider: gemini | deepseek | puter | groq | ollama | anthropic
# (alias "gemeni" is accepted and maps to gemini)
AI_PROVIDER=gemini

# Google Gemini — recommended (free tier at AI Studio)
# Get API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyCduXkT50-Lu8eAjnUECXHTwE9t0cFj4hE
# Alias accepted: GEMINI_AUTH_TOKEN
GEMINI_MODEL=gemini-3.5-flash

# Platform (optional)
PLATFORM_ARTIFACTS_DIR=./test-outputs/platform
TESTMIND_TUNNEL_ENABLED=false
TESTMIND_TUNNEL_LOCAL_URL=http://localhost:3000

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Puter — free Claude API (legacy)
PUTER_AUTH_TOKEN=your_puter_auth_token_here
PUTER_MODEL=claude-sonnet-4-6

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic (paid)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

JWT_SECRET=change-this-to-a-long-random-string

PORT=3001
NODE_ENV=development
DB_PATH=./testmind.db
ALLURE_RESULTS_DIR=./test-outputs/allure-results
SCRIPTS_OUTPUT_DIR=./test-outputs/scripts
REPORTS_OUTPUT_DIR=./test-outputs/reports
