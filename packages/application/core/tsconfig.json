{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../../..",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "paths": {
      "@testmind/domain": ["packages/core/domain/src/index.ts"],
      "@testmind/shared-kernel": ["packages/shared/shared-kernel/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../core/domain" },
    { "path": "../../shared/shared-kernel" }
  ],
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "test", "coverage"]
}
